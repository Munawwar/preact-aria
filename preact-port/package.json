{
  "name": "preact-aria-components",
  "version": "1.21.1-preact.0",
  "description": "React Aria Components port for Preact 11",
  "license": "Apache-2.0",
  "source": "vendor/react-aria-components/exports/index.ts",
  "files": [
    "dist/index.js",
    "dist/index.js.map",
    "dist/types",
    "LICENSE",
    "README.md",
    "VERIFICATION.md",
    "verification/results.json",
    "compat/react.mjs",
    "upstream-patches.json",
    "example-patches.json"
  ],
  "type": "module",
  "sideEffects": [
    "./examples/**"
  ],
  "module": "dist/index.js",
  "types": "dist/types/react-aria-components/exports/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/react-aria-components/exports/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "sync": "node scripts/sync.mjs",
    "start": "npm run build && npm run sync:examples && node scripts/ssr-page.mjs && parcel serve --target app --port 4100 --host 0.0.0.0 --no-autoinstall",
    "build": "npm run check:upstream && npm run sync && parcel build vendor/react-aria-components/exports/index.ts --target module --no-cache --no-autoinstall && npm run types && node scripts/check-bundle.mjs",
    "types": "node scripts/declarations.mjs --clean && tsc -p tsconfig.json && node scripts/declarations.mjs",
    "format": "oxfmt --config ../.oxfmtrc.json scripts examples diagnostics test compat",
    "lint": "oxlint --config .oxlintrc.json scripts examples diagnostics test compat",
    "test": "node --test test/*.test.mjs",
    "build:examples": "npm run build && npm run sync:examples && node scripts/ssr-page.mjs && parcel build --target app --no-cache --no-scope-hoist --no-optimize --no-autoinstall",
    "test:types": "tsc -p test/tsconfig.json && tsc -p test/tsconfig.nodenext.json",
    "check:upstream": "node scripts/check-upstream.mjs",
    "build:pages": "node scripts/build-pages.mjs",
    "publish:pages": "node scripts/publish-pages.mjs",
    "hooks:install": "node scripts/install-hooks.mjs",
    "sync:examples": "node scripts/sync-examples.mjs && tailwindcss -i examples/tailwind.input.css -o examples/generated/tailwind.css --minify"
  },
  "dependencies": {
    "@internationalized/date": "3.12.4",
    "@internationalized/number": "3.6.8",
    "@internationalized/string": "3.2.10",
    "@swc/helpers": "^0.5.0",
    "aria-hidden": "^1.2.3",
    "clsx": "^2.0.0"
  },
  "devDependencies": {
    "@internationalized/string-compiler": "3.4.1",
    "@parcel/resolver-glob": "^2.16.0",
    "@tailwindcss/cli": "4.3.3",
    "emojibase-data": "17.0.0",
    "lucide-react": "0.517.0",
    "motion": "12.23.6",
    "oxfmt": "latest",
    "oxlint": "latest",
    "parcel": "^2.16.0",
    "preact": "11.0.0",
    "preact-render-to-string": "^6.7.0",
    "tailwind-merge": "3.7.0",
    "tailwind-variants": "0.3.1",
    "tailwindcss": "4.3.3",
    "tailwindcss-react-aria-components": "2.0.1",
    "tw-animate-css": "1.4.0",
    "typescript": "^5.9.3"
  },
  "peerDependencies": {
    "preact": "^11.0.0"
  },
  "overrides": {
    "@swc/core": "1.13.5"
  },
  "@parcel/resolver-default": {
    "packageExports": true
  },
  "targets": {
    "module": {
      "isLibrary": true,
      "includeNodeModules": [
        "react-aria",
        "react-stately",
        "react-aria-components",
        "react",
        "use-sync-external-store",
        "react-dom"
      ],
      "outputFormat": "esmodule",
      "engines": {
        "browsers": [
          "Chrome >= 90",
          "Firefox >= 90",
          "Safari >= 15"
        ]
      }
    },
    "types": false,
    "app": {
      "context": "browser",
      "source": [
        "examples/index.html",
        "examples/hydration.html",
        "examples/utilities.html"
      ],
      "distDir": "artifacts/site",
      "isLibrary": false
    },
    "pages": {
      "context": "browser",
      "source": [
        "examples/index.html",
        "examples/hydration.html",
        "examples/utilities.html"
      ],
      "distDir": "site",
      "publicUrl": "./",
      "sourceMap": false,
      "isLibrary": false
    }
  },
  "alias": {
    "react": "./compat/react.mjs",
    "use-sync-external-store/shim/index.js": "./compat/react.mjs",
    "react-dom": "./compat/react.mjs",
    "react/jsx-runtime": "preact/jsx-runtime",
    "react/jsx-dev-runtime": "preact/jsx-dev-runtime"
  }
}
